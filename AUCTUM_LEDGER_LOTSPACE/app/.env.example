# Auctum Ledger — environment template
# Copy to .env (api) / .env.local (vite) and fill in real values.

# --- API server (Express, port 3001) ---
AI_PROXY_PORT=3001
# CSV of allowed CORS origins for the API
AI_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
NODE_ENV=development

# --- Data services ---
# Leave DATABASE_URL unset to run routes against in-memory fixtures (dev/test).
DATABASE_URL=postgresql://auctum-ledger:auctum-ledger@localhost:5432/auctum-ledger
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

# --- Auth (OIDC) ---
OIDC_ISSUER=https://auth.auctumledger.io
OIDC_AUDIENCE=auctum-ledger-api
# Dev-only escape hatches (ignored when NODE_ENV=production):
# AUTH_DISABLE=true bypasses JWT auth entirely.
AUTH_DISABLE=true
# LOCAL_JWT accepts HS256 tokens signed with this secret for local testing.
LOCAL_JWT=

# --- AI chat proxy ---
# When unset, /api/v1/chat answers with a dev stub echo.
OPENAI_API_KEY=

# --- Outbox relay ---
OUTBOX_RELAY_INTERVAL_MS=5000

# --- Frontend (Vite build args; read by app/src) ---
VITE_API_BASE_URL=/api/v1
VITE_AI_PROXY_URL=http://localhost:3001
