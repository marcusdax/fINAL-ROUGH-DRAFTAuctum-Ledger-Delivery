# Auctum Ledger — docker-local environment (points at compose-exposed ports).
# Copy to app/.env for local runs of `npm run server:dev` / `db:migrate` against
# the dev compose stack.
DATABASE_URL=postgresql://auctum-ledger:auctum-ledger@localhost:5432/auctum-ledger
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
AI_PROXY_PORT=3001
AI_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
OIDC_ISSUER=https://auth.auctumledger.io
OIDC_AUDIENCE=auctum-ledger-api
AUTH_DISABLE=true
NODE_ENV=development
